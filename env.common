# ============================================================================
# Common Environment Variables Template (Minimal)
# ============================================================================
# 
# This is a simplified version with only the most commonly used credentials.
# For more options, see env.example
# 
# Setup:
#   cp ~/.dotfiles/env.common ~/.env
#   chmod 600 ~/.env
#   vim ~/.env  # Add your credentials
#
# Auto-loaded by .zshrc on shell startup
#
# After updating this file:
#   source ~/.env              # Reload in current terminal
#   OR
#   Open a new terminal        # Automatically loaded by .zshrc
#
# Verify variables are loaded:
#   echo $AWS_ACCESS_KEY_ID
#   echo $GITHUB_TOKEN
# ============================================================================

# ----------------------------------------------------------------------------
# AWS Credentials
# ----------------------------------------------------------------------------
# Get from: https://console.aws.amazon.com/iam/home#/security_credentials
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="us-east-1"

# ----------------------------------------------------------------------------
# GitHub
# ----------------------------------------------------------------------------
# Personal Access Token: https://github.com/settings/tokens
export GITHUB_TOKEN=""

# ----------------------------------------------------------------------------
# Hugging Face
# ----------------------------------------------------------------------------
# Get from: https://huggingface.co/settings/tokens
export HUGGINGFACE_TOKEN=""
export HF_TOKEN="$HUGGINGFACE_TOKEN"

# ----------------------------------------------------------------------------
# Weights & Biases (wandb)
# ----------------------------------------------------------------------------
# Get from: https://wandb.ai/authorize
export WANDB_API_KEY=""

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
export POSTGRES_HOST="localhost"
export POSTGRES_PORT="5432"
export POSTGRES_USER=""
export POSTGRES_PASSWORD=""
export POSTGRES_DB=""
# Optionally, use a connection string instead:
# export DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ----------------------------------------------------------------------------
# Docker Hub
# ----------------------------------------------------------------------------
export DOCKER_USERNAME=""
export DOCKER_PASSWORD=""  # Or use an access token

# ----------------------------------------------------------------------------
# Python Settings
# ----------------------------------------------------------------------------
export PYTHONUNBUFFERED=1
export EDITOR="vim"

# For more options (OpenAI, Anthropic, Google Cloud, Azure, MongoDB, etc.), 
# see: ~/.dotfiles/env.example

