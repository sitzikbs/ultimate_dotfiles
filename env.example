# ============================================================================
# Environment Variables Template
# ============================================================================
# 
# Copy this file to ~/.env and fill in your actual credentials
# 
# Usage:
#   cp ~/.dotfiles/env.example ~/.env
#   chmod 600 ~/.env
#   vim ~/.env  # Add your real credentials
#
# Security:
#   - Never commit the actual .env file to git
#   - Keep permissions restrictive: chmod 600 ~/.env
#   - Use different credentials for dev/staging/prod
#
# This file is automatically sourced by .zshrc on shell startup
#
# After updating this file:
#   source ~/.env              # Reload in current terminal
#   OR
#   Open a new terminal        # Automatically loaded by .zshrc
#
# Verify variables are loaded:
#   echo $AWS_ACCESS_KEY_ID
#   echo $GITHUB_TOKEN
# ============================================================================

# ----------------------------------------------------------------------------
# AWS Credentials
# ----------------------------------------------------------------------------
# Get these from: https://console.aws.amazon.com/iam/home#/security_credentials
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="us-east-1"
# export AWS_PROFILE="default"  # Uncomment if using named profiles
# export AWS_SESSION_TOKEN=""   # For temporary credentials

# ----------------------------------------------------------------------------
# GitHub / Git
# ----------------------------------------------------------------------------
# Personal Access Token: https://github.com/settings/tokens
export GITHUB_TOKEN=""
# export GITHUB_USERNAME=""

# For GitHub CLI (gh)
# export GH_TOKEN="$GITHUB_TOKEN"

# ----------------------------------------------------------------------------
# Hugging Face
# ----------------------------------------------------------------------------
# Get token from: https://huggingface.co/settings/tokens
export HUGGINGFACE_TOKEN=""
export HF_TOKEN="$HUGGINGFACE_TOKEN"  # Alias commonly used
# export HF_HOME="$HOME/.cache/huggingface"  # Cache directory

# ----------------------------------------------------------------------------
# OpenAI
# ----------------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
export OPENAI_API_KEY=""
# export OPENAI_ORGANIZATION=""  # Optional: for organization members

# ----------------------------------------------------------------------------
# Anthropic (Claude)
# ----------------------------------------------------------------------------
# Get from: https://console.anthropic.com/
export ANTHROPIC_API_KEY=""

# ----------------------------------------------------------------------------
# Google Cloud / Gemini
# ----------------------------------------------------------------------------
export GOOGLE_API_KEY=""
# export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"
# export GCLOUD_PROJECT=""

# ----------------------------------------------------------------------------
# Azure / OpenAI Azure
# ----------------------------------------------------------------------------
# export AZURE_OPENAI_API_KEY=""
# export AZURE_OPENAI_ENDPOINT=""
# export AZURE_OPENAI_DEPLOYMENT_NAME=""

# ----------------------------------------------------------------------------
# Docker Hub
# ----------------------------------------------------------------------------
# export DOCKER_USERNAME=""
# export DOCKER_PASSWORD=""  # Consider using access tokens instead

# ----------------------------------------------------------------------------
# Python Package Index (PyPI)
# ----------------------------------------------------------------------------
# For publishing packages
# export TWINE_USERNAME="__token__"
# export TWINE_PASSWORD=""  # Your PyPI API token

# ----------------------------------------------------------------------------
# Weights & Biases (wandb)
# ----------------------------------------------------------------------------
# Get from: https://wandb.ai/authorize
# export WANDB_API_KEY=""
# export WANDB_PROJECT=""
# export WANDB_ENTITY=""

# ----------------------------------------------------------------------------
# Kaggle
# ----------------------------------------------------------------------------
# Download from: https://www.kaggle.com/settings (Create New API Token)
# export KAGGLE_USERNAME=""
# export KAGGLE_KEY=""

# ----------------------------------------------------------------------------
# Jupyter / JupyterLab
# ----------------------------------------------------------------------------
# export JUPYTER_TOKEN=""
# export JUPYTER_PORT="8888"

# ----------------------------------------------------------------------------
# Database Connections
# ----------------------------------------------------------------------------
# PostgreSQL
# export DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
# export POSTGRES_HOST="localhost"
# export POSTGRES_PORT="5432"
# export POSTGRES_USER=""
# export POSTGRES_PASSWORD=""
# export POSTGRES_DB=""

# MongoDB
# export MONGODB_URI="mongodb://localhost:27017/dbname"

# Redis
# export REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------------
# API Keys (Various Services)
# ----------------------------------------------------------------------------
# Replicate
# export REPLICATE_API_TOKEN=""

# Cohere
# export COHERE_API_KEY=""

# Pinecone (Vector DB)
# export PINECONE_API_KEY=""
# export PINECONE_ENVIRONMENT=""

# Supabase
# export SUPABASE_URL=""
# export SUPABASE_KEY=""

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Python
export PYTHONUNBUFFERED=1  # Force Python output to be unbuffered
# export PYTHONPATH="$HOME/projects:$PYTHONPATH"

# Node.js
# export NODE_ENV="development"
# export NPM_TOKEN=""

# General
export EDITOR="vim"  # or "nano", "code", etc.
# export VISUAL="code"

# ----------------------------------------------------------------------------
# Custom Project Variables
# ----------------------------------------------------------------------------
# Add your project-specific variables here
# export MY_PROJECT_API_KEY=""
# export MY_SERVICE_URL=""

# ----------------------------------------------------------------------------
# Security Notes
# ----------------------------------------------------------------------------
# 1. Never commit this file with real credentials to version control
# 2. Use different credentials for different environments (dev/staging/prod)
# 3. Rotate credentials regularly
# 4. Consider using a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 5. For team projects, use a .env.example template and document required variables
# 6. Set restrictive permissions: chmod 600 ~/.env

